# Backend Environment Variables Example
# Copy this file to .env in the backend directory or set in Render Environment settings

# PostgreSQL Database connection URL from Aiven
# Format: postgresql://username:password@host:port/dbname?sslmode=require
DATABASE_URL=postgresql://avnadmin:your_password@your-aiven-pg-host.aivencloud.com:28812/defaultdb?sslmode=require

# OpenAI API key for generation features
OPENAI_API_KEY=sk-proj-your_openai_api_key

# Cloudinary configuration (either CLOUDINARY_URL or individual credentials)
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
# OR
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# MongoDB URI (Optional: for logging AI test generation runs)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# JWT Auth Secret Key (Optional / Recommended)
SECRET_KEY=your_random_secret_key_here
